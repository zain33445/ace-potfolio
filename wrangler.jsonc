{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "ace-services",
	"compatibility_date": "2026-08-17",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"vars": {
		"NEXT_PUBLIC_SANITY_PROJECT_ID": "q2s1xe6q",
		"NEXT_PUBLIC_SANITY_DATASET": "production"
	},
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS",
		// Cloudflare's default ("auto-trailing-slash") 307s /foo.html -> /foo,
		// which would break Google's site-verification file — it must return 200
		// at its exact path. No other .html assets are served this way; every
		// real route is rendered by the worker.
		"html_handling": "none"
	},
	// Theaceservices.com zone does not exist in Account B yet, so the custom
	// domain cannot be attached here — deploying to *.workers.dev until the zone
	// is added. Uncomment to reattach once B owns the zone.
	// "routes": [
	// 	{ "pattern": "theaceservices.com", "custom_domain": true }
	// ],
	"workers_dev": true,
	"services": [
		{
			"binding": "WORKER_SELF_REFERENCE",
			"service": "ace-services"
		}
	],
	// Runs background ISR revalidations for stale cache entries, dispatched
	// by the OpenNext queue override (see open-next.config.ts). Uses SQLite
	// storage, hence new_sqlite_classes below.
	"durable_objects": {
		"bindings": [
			{
				"name": "NEXT_CACHE_DO_QUEUE",
				"class_name": "DOQueueHandler"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["DOQueueHandler"]
		}
	],
	// Account B migration. R2 bucket + D1 DB were created explicitly in Account B
	// because OpenNext's populateCache step reads these out of config before
	// Wrangler runs, so auto-provisioning cannot fill them in. ESTIMATES_KV was
	// auto-provisioned (ace-services-estimates-kv); its ID is pinned here because
	// Wrangler 4.129.1 did not write it back on its own. Restore Account A IDs
	// from migration/wrangler.jsonc.accountA.bak to deploy back to A.
	"r2_buckets": [
		{
			"binding": "NEXT_INC_CACHE_R2_BUCKET",
			"bucket_name": "ace-services-opennext-cache"
		}
	],
	"kv_namespaces": [
		{
			"binding": "ESTIMATES_KV",
			"id": "373b6c22221343408a52a96e6d450b41",
			"preview_id": "373b6c22221343408a52a96e6d450b41"
		}
	],
	// Backs the OpenNext tag cache (see open-next.config.ts). Required for
	// revalidatePath/revalidateTag to actually invalidate anything.
	"d1_databases": [
		{
			"binding": "NEXT_TAG_CACHE_D1",
			"database_name": "ace-services-tag-cache",
			"database_id": "219a739c-5deb-4463-9689-bbdf32451b7c"
		}
	],
	"images": {
		"binding": "IMAGES"
	}
}
